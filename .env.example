APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=./data/precision_teaching.db
# 默认不写入演示数据；仅需要旧版示例项目时设置为 1。
# SEED_DEMO_DATA=1
UPLOAD_PATH=./data/uploads
# 可选：自定义模型服务的可信 CA 证书包；macOS 默认自动使用 /etc/ssl/cert.pem。
# AI_CA_BUNDLE=/absolute/path/to/cert.pem
AI_PROVIDER=mock
# 外部模型接入时再配置，切勿提交真实密钥：
# DeepSeek（用于任务量规与学生个体报告）：
# AI_PROVIDER=deepseek
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=sk-...
# AI_MODEL=deepseek-flash
# OpenRouter（教师端与学生端可共用一个密钥）：
# OPENROUTER_API_KEY=sk-or-v1-...
# AI_PROVIDER=openrouter
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openai/gpt-6-luna-pro
# STUDENT_AI_PROVIDER=openrouter
# STUDENT_AI_BASE_URL=https://openrouter.ai/api/v1
# STUDENT_AI_MODEL=openai/gpt-6-luna-pro
# OpenAI / Responses API：
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=

# 学生诊断对话默认使用本地中性追问。接入真实模型时改为 openai 或 openai_compatible。
STUDENT_AI_PROVIDER=mock
STUDENT_AI_BASE_URL=https://api.openai.com/v1
# STUDENT_AI_API_KEY=
# STUDENT_AI_MODEL=
# DeepSeek 学生对话配置：
# STUDENT_AI_PROVIDER=deepseek
# STUDENT_AI_BASE_URL=https://api.deepseek.com
# STUDENT_AI_API_KEY=sk-...
# STUDENT_AI_MODEL=deepseek-flash
