{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skills/precision-intervention-goal-path-design/goal-path-input.schema.json",
  "title": "Precision intervention goal and path design input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "precision_teaching_context",
    "diagnosis_bundle",
    "teacher_instructional_context"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "precision_teaching_context": {"$ref": "#/$defs/precisionTeachingContext"},
    "diagnosis_bundle": {"$ref": "#/$defs/diagnosisBundle"},
    "teacher_instructional_context": {"$ref": "#/$defs/teacherInstructionalContext"}
  },
  "$defs": {
    "levelCode": {
      "type": "string",
      "enum": ["P", "U", "M", "R", "EA"]
    },
    "studentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["student_id", "student_name"],
      "properties": {
        "student_id": {"type": "string", "minLength": 1},
        "student_name": {"type": "string", "minLength": 1}
      }
    },
    "precisionTeachingContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "grade",
        "textbook_version_and_chapter",
        "precision_teaching_topic",
        "precision_teaching_goals",
        "precision_teaching_content"
      ],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "grade": {"type": "string", "minLength": 1},
        "textbook_version_and_chapter": {"type": "string", "minLength": 1},
        "precision_teaching_topic": {"type": "string", "minLength": 1},
        "precision_teaching_goals": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "precision_teaching_content": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "distributionItem": {
      "type": "object",
      "required": ["level", "count", "students"],
      "properties": {
        "level": {"$ref": "#/$defs/levelCode"},
        "level_name": {"type": "string"},
        "level_meaning": {"type": "string"},
        "count": {"type": "integer", "minimum": 0},
        "proportion": {"type": "number", "minimum": 0, "maximum": 1},
        "students": {
          "type": "array",
          "items": {"$ref": "#/$defs/studentRef"}
        }
      },
      "additionalProperties": true
    },
    "classDiagnosis": {
      "type": "object",
      "required": [
        "class_summary",
        "overall_diagnosis",
        "level_analyses",
        "teaching_priorities",
        "grouping_recommendations",
        "intervention_design_basis",
        "traceability"
      ],
      "properties": {
        "class_summary": {
          "type": "object",
          "required": ["total_students", "distribution"],
          "properties": {
            "total_students": {"type": "integer", "minimum": 1},
            "distribution": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {"$ref": "#/$defs/distributionItem"}
            }
          },
          "additionalProperties": true
        },
        "overall_diagnosis": {"type": "object"},
        "level_analyses": {"type": "array", "minItems": 1},
        "teaching_priorities": {"type": "object"},
        "grouping_recommendations": {"type": "object"},
        "intervention_design_basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "basis_id",
              "target_students",
              "diagnostic_finding",
              "intended_cognitive_change",
              "design_requirements"
            ],
            "properties": {
              "basis_id": {"type": "string", "minLength": 1},
              "target_students": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/studentRef"}
              },
              "diagnostic_finding": {"type": "string", "minLength": 1},
              "intended_cognitive_change": {"type": "string", "minLength": 1},
              "design_requirements": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": true
          }
        },
        "traceability": {
          "type": "object",
          "required": ["levels_unchanged", "level_assignments"],
          "properties": {
            "levels_unchanged": {"const": true},
            "level_assignments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["student_id", "original_level"],
                "properties": {
                  "student_id": {"type": "string", "minLength": 1},
                  "original_level": {"$ref": "#/$defs/levelCode"}
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "diagnosisBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_diagnosis"],
      "properties": {
        "class_diagnosis": {"$ref": "#/$defs/classDiagnosis"},
        "task_specific_solo_rubric": {"type": ["object", "null"]},
        "student_diagnosis_results": {
          "type": "array",
          "items": {"type": "object"}
        },
        "source_versions": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "teacherInstructionalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teaching_content_and_curriculum_analysis",
        "teaching_focus_and_difficulty_analysis",
        "planned_duration_minutes",
        "teaching_environment_and_ai_support_conditions"
      ],
      "properties": {
        "teaching_content_and_curriculum_analysis": {"type": "string", "minLength": 1},
        "teaching_focus_and_difficulty_analysis": {"type": "string", "minLength": 1},
        "planned_duration_minutes": {"type": "integer", "minimum": 1},
        "teaching_environment_and_ai_support_conditions": {"type": "string", "minLength": 1},
        "teacher_lesson_conception": {"type": ["string", "null"]}
      }
    }
  }
}
