{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skills/solo-task-rubric-builder/task-rubric-input.schema.json",
  "title": "Task-specific SOLO rubric builder input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "precision_teaching_context",
    "diagnostic_task"
  ],
  "properties": {
    "precision_teaching_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "grade",
        "textbook_version_and_chapter",
        "precision_teaching_topic",
        "precision_teaching_goals",
        "precision_teaching_content"
      ],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "grade": {"type": "string", "minLength": 1},
        "textbook_version_and_chapter": {"type": "string", "minLength": 1},
        "precision_teaching_topic": {"type": "string", "minLength": 1},
        "precision_teaching_goals": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "precision_teaching_content": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "diagnostic_task": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_text"],
          "properties": {
            "task_text": {"type": "string", "minLength": 1},
            "materials": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "requirements": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "student_responses": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {"type": "object", "minProperties": 1}
        ]
      }
    }
  }
}
