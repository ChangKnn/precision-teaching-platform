{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/precision-diagnostic-task-design/input.schema.json",
  "title": "精准诊断任务设计输入",
  "type": "object",
  "required": ["precision_teaching_context"],
  "additionalProperties": false,
  "properties": {
    "precision_teaching_context": {
      "type": "object",
      "required": [
        "subject",
        "grade",
        "textbook_version_and_chapter",
        "precision_teaching_topic",
        "precision_teaching_goals",
        "precision_teaching_content"
      ],
      "additionalProperties": false,
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "grade": {"type": "string", "minLength": 1},
        "textbook_version_and_chapter": {"type": "string", "minLength": 1},
        "precision_teaching_topic": {"type": "string", "minLength": 1},
        "precision_teaching_goals": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "precision_teaching_content": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

