{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task image reading",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_text", "geometry_notes", "uncertainties"],
  "properties": {
    "task_text": {"type": "string", "minLength": 1, "maxLength": 8000},
    "geometry_notes": {"type": "string", "maxLength": 4000},
    "uncertainties": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1}}
  }
}
