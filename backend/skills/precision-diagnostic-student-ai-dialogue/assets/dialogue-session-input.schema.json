{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/precision-diagnostic-student-ai-dialogue/input.schema.json",
  "title": "精准诊断生机会话输入",
  "type": "object",
  "additionalProperties": false,
  "required": ["precision_teaching_context", "diagnostic_task", "ai_dialogue_contract", "student", "dialogue_state"],
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "role", "content"],
      "properties": {
        "turn_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["assistant", "student"]},
        "content": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "precision_teaching_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "grade", "textbook_version_and_chapter", "precision_teaching_topic", "precision_teaching_goals", "precision_teaching_content"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "grade": {"type": "string", "minLength": 1},
        "textbook_version_and_chapter": {"type": "string", "minLength": 1},
        "precision_teaching_topic": {"type": "string", "minLength": 1},
        "precision_teaching_goals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "precision_teaching_content": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "diagnostic_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "name", "task_content"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "task_content": {"type": "string", "minLength": 20},
        "estimated_duration_minutes": {"type": "integer", "minimum": 10, "maximum": 30}
      }
    },
    "ai_dialogue_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "teacher_confirmed", "ai_role", "required_rules", "prohibited_behaviors"],
      "properties": {
        "contract_version": {"type": "string", "minLength": 1},
        "teacher_confirmed": {"const": true},
        "ai_role": {"type": "string", "minLength": 1},
        "required_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "prohibited_behaviors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "student": {
      "type": "object",
      "additionalProperties": false,
      "required": ["student_id", "student_name"],
      "properties": {
        "student_id": {"type": "string", "minLength": 1},
        "student_name": {"type": "string", "minLength": 1}
      }
    },
    "dialogue_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "mode", "turn_index", "dialogue_history", "current_student_message"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["start", "respond"]},
        "turn_index": {"type": "integer", "minimum": 0},
        "dialogue_history": {"type": "array", "items": {"$ref": "#/$defs/message"}},
        "current_student_message": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "start"}}},
          "then": {"properties": {"current_student_message": {"type": "null"}}}
        },
        {
          "if": {"properties": {"mode": {"const": "respond"}}},
          "then": {"properties": {"current_student_message": {"type": "string", "minLength": 1}}}
        }
      ]
    }
  }
}

